{
  "name": "scribble",
  "version": "0.1.0",
  "description": "Local-first voice workspace for macOS",
  "private": true,
  "license": "MIT",
  "author": "Scribble contributors",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.mjs",
    "setup:speech": "node scripts/setup-speech.mjs",
    "setup": "npm run build:native && npm run setup:speech && npm run setup:ffmpeg",
    "test": "node --test test/*.test.js tests/*.test.js",
    "icons": "node scripts/icons.cjs",
    "package": "npm run build:native && npm run build:share && npm run prepare:runtime && npm run icons && electron-builder --mac dir",
    "dist": "npm run build:native && npm run build:share && npm run prepare:runtime && npm run icons && electron-builder --mac dmg zip",
    "setup:parakeet": "node scripts/setup-parakeet.mjs",
    "setup:ai": "node scripts/setup-ai.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.mjs",
    "build:share": "node scripts/build-share-extension.mjs"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "adm-zip": "^0.6.1",
    "markdown-it": "15.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "org.scribble.voice",
    "productName": "Scribble",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "native/Parakeet/models.json",
      "native/Parakeet/catalog-models.json",
      "scripts/scribble.cjs"
    ],
    "extraResources": [
      {
        "from": "release/native/scribble-bridge",
        "to": "native/scribble-bridge"
      },
      {
        "from": "release/runtime/whisper-cli",
        "to": "native/speech/whisper-cli"
      },
      {
        "from": "release/runtime/WHISPER-LICENSE",
        "to": "native/speech/WHISPER-LICENSE"
      },
      {
        "from": "release/runtime/parakeet",
        "to": "native/parakeet",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "release/runtime/ollama",
        "to": "runtime/ollama"
      },
      {
        "from": "release/runtime/ffmpeg",
        "to": "native/ffmpeg"
      },
      {
        "from": "release/runtime/licenses/ffmpeg",
        "to": "native/ffmpeg-notices"
      },
      {
        "from": "release/native/scribble-image-codec",
        "to": "native/scribble-image-codec"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "native/entitlements.plist",
      "entitlementsInherit": "native/entitlements.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Scribble records your voice for local transcription.",
        "NSScreenCaptureUsageDescription": "Scribble captures meeting system audio when you start a meeting recording and screen images when you enable Command Mode screen context.",
        "NSAppleEventsUsageDescription": "Scribble inserts your dictation in the application you are using."
      },
      "minimumSystemVersion": "14.0.0",
      "identity": "-",
      "signIgnore": [
        "runtime/ollama/",
        "native/parakeet/.*\\.bundle",
        "native/ffmpeg-notices/",
        "PlugIns/ScribbleShare\\.appex"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "m4a",
          "aac",
          "ogg",
          "flac",
          "wma",
          "opus",
          "mp4",
          "mov",
          "avi",
          "mkv",
          "flv",
          "wmv",
          "webm",
          "mpeg",
          "mpg"
        ],
        "name": "Audio or video recording",
        "role": "Viewer"
      }
    ],
    "extraFiles": [
      {
        "from": "release/native/ScribbleShare.appex",
        "to": "PlugIns/ScribbleShare.appex"
      }
    ],
    "afterPack": "scripts/verify-package-architecture.cjs"
  },
  "bin": {
    "scribble": "scripts/scribble.cjs"
  }
}
